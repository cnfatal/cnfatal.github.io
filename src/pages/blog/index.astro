---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Container from '../../components/Container.astro';
import PostList from '../../components/PostList.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../../consts';
import { getCollection } from 'astro:content';
import { byDateDesc } from '../../utils/posts';

const posts = (await getCollection('blog')).sort(byDateDesc);
---

<BaseLayout title={`文章 | ${SITE_TITLE}`} description={SITE_DESCRIPTION}>
	<Container class="py-12">
		<header class="mb-12">
			<h1 class="text-3xl md:text-4xl font-extrabold text-fg tracking-tight">全部文章</h1>
			<p class="mt-4 text-xl text-muted">共 {posts.length} 篇，按发布时间倒序排列。</p>
		</header>
		<PostList posts={posts} />
	</Container>
</BaseLayout>
