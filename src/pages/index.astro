---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';
import { getCollection } from 'astro:content';
import FormattedDate from '../components/FormattedDate.astro';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
).slice(0, 5);
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body class="bg-gray-50 antialiased min-h-screen flex flex-col">
		<Header />
		<main class="flex-grow max-w-4xl mx-auto px-4 py-12 w-full">
			<section class="mb-16">
				<h1 class="text-4xl md:text-5xl font-extrabold text-gray-900 tracking-tight mb-4">Hello, World! 👋</h1>
				<p class="text-xl text-gray-600 leading-relaxed max-w-2xl">
					Welcome to my personal knowledge base and blog. I write about Golang, Kubernetes, Linux, and Cloud Native technologies.
				</p>
			</section>

            <section>
                <div class="flex items-center justify-between mb-8">
                    <h2 class="text-2xl font-bold text-gray-900">Recent Posts</h2>
                    <a href="/blog" class="text-blue-600 hover:text-blue-800 font-medium flex items-center gap-1">
                        View all <span aria-hidden="true">&rarr;</span>
                    </a>
                </div>
                <div class="grid gap-8">
                    {posts.map((post) => (
                        <article class="group relative flex flex-col items-start justify-between bg-white p-6 rounded-2xl shadow-sm border border-gray-100 hover:shadow-md transition-shadow">
                            <div class="flex items-center gap-x-4 text-xs">
                                <time datetime={post.data.pubDate.toISOString()} class="text-gray-500">
                                    <FormattedDate date={post.data.pubDate} />
                                </time>
                                {post.data.tags && post.data.tags[0] && (
                                    <a href={`/tags/${post.data.tags[0]}`} class="relative z-10 rounded-full bg-gray-50 px-3 py-1.5 font-medium text-gray-600 hover:bg-gray-100">
                                        {post.data.tags[0]}
                                    </a>
                                )}
                            </div>
                            <div class="group relative">
                                <h3 class="mt-3 text-xl font-semibold leading-6 text-gray-900 group-hover:text-blue-600 transition-colors">
                                    <a href={`/blog/${post.id}`}>
                                        <span class="absolute inset-0"></span>
                                        {post.data.title}
                                    </a>
                                </h3>
                                <p class="mt-3 line-clamp-3 text-sm leading-6 text-gray-600">{post.data.description}</p>
                            </div>
                        </article>
                    ))}
                </div>
            </section>
		</main>
		<Footer />
	</body>
</html>
