---
import BaseLayout from '../layouts/BaseLayout.astro';
import Container from '../components/Container.astro';
---

<BaseLayout title="页面不存在" description="404 - 页面不存在">
	<Container class="py-24 text-center">
		<p class="text-sm font-semibold text-accent">404</p>
		<h1 class="mt-4 text-3xl md:text-4xl font-extrabold text-fg tracking-tight">页面不存在</h1>
		<p class="mt-4 text-lg text-muted">这个地址下的内容可能已经被移动或删除。</p>
		<div class="mt-8 flex justify-center gap-4">
			<a href="/" class="rounded-lg bg-accent-solid px-4 py-2 text-sm font-medium text-white hover:bg-accent-solid-hover">回到首页</a>
			<a href="/blog" class="rounded-lg border border-line-strong px-4 py-2 text-sm font-medium text-fg hover:bg-surface-soft">浏览文章</a>
		</div>
	</Container>
</BaseLayout>
