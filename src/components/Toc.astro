---
import type { MarkdownHeading } from 'astro';

interface Props {
	headings: MarkdownHeading[];
}

const { headings } = Astro.props;
---

<ul class="space-y-1.5 border-l border-line pl-3 text-sm">
	{headings.map((heading) => (
		<li class={heading.depth === 3 ? 'ml-3' : ''}>
			<a
				href={`#${heading.slug}`}
				data-toc
				class="block text-muted transition-colors hover:text-accent dark:text-subtle dark:hover:text-accent"
			>{heading.text}</a>
		</li>
	))}
</ul>
